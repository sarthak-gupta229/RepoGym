# ==============================================================================
# RepoGym Environment Configuration Template
# ==============================================================================

# AI Evaluation Gateway (OpenRouter)
# Used on the server to generate questions and grade student responses.
# Obtain key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub REST API Token
# Used on the server to fetch repo file trees and contents without strict 60 req/hr limits.
# Obtain token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Supabase Authentication & PostgreSQL Database
# Obtain these credentials from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
