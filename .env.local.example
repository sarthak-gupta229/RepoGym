# ==============================================================================
# RepoGym Local Environment Variables Template (.env.local)
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# AI Evaluation Gateway (OpenRouter)
# Model used: nvidia/nemotron-3-ultra-550b-a55b:free
# Obtain key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub REST API Token (read-only for public repos)
# Obtain token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Supabase Project Credentials
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Voice AI Models (Hugging Face)
# - Speech-to-Text: openai/whisper-small
# - Text-to-Speech: hexgrad/Kokoro-82M
# Free inference token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

